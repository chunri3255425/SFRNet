# 检查点与模型权重
checkpoints/
weights/*
assets/weights/*
*.pth
*.pt
*.onnx
*.safetensors
# 但保留权重目录结构占位
!assets/weights/.gitkeep
!weights/.gitkeep

# 数据目录
data/

# 厂商手册与规格书 PDF（合计 ~25 MB，可从厂商资料站重新下载，不入库）
# 用「目录/* + !.gitkeep」写法保留目录结构；写成「目录/」会让例外规则失效
docs/vendor/purplepi-oh2/*
docs/vendor/som7609/*
!docs/vendor/purplepi-oh2/.gitkeep
!docs/vendor/som7609/.gitkeep

# Windows 侧开发板工具链与虚拟机镜像（合计 ~4.8 GB：Rockchip 烧录/量产/写号 GUI、
# MobaXterm、adb/hdc、VirtualBox + Ubuntu22.04 ISO）。
# 全是可从厂商资料站与开源上游重新下载的第三方二进制，且本平台（Linux）跑不起来，不入库。
Tools/

# 厂商预编译固件（14 个 update.img 压缩包，合计 ~20 GB，解压后单个 .img 达 6.15 GB）。
# 只能从厂商网盘重下，且属于烧录输入件而非代码产物，不入库。
预编译固件/

# 定时截屏产物与本地测试样张 (capture_screen.sh / samples/)
captures/
samples/

# 日志
logs/
*.log

# 操作系统
.DS_Store
Thumbs.db

# 测试
.pytest_cache/
.coverage
htmlcov/

# 导出目录
output/
exports/

# 缓存
.cache/
*.cache
torch_save_tb/
runs/
# ---- build 产物（不入库） ----
build/models/
build/dist/
build/calib/*.jpg

# ---- 模型转换用的一次性 venv 与算子探针产物（不入库）----
# venv 里装了 rknn-toolkit2 + torch（~1.5 GB），且里面有 onnx.mapping 兼容垫片，属于环境不属于代码
.venv-convert/
build/probes/

venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 检查点与模型权重
checkpoints/
weights/*
assets/weights/*
*.pth
*.pt
*.onnx
*.safetensors
# 但保留权重目录结构占位
!assets/weights/.gitkeep
!weights/.gitkeep

# 数据目录
data/

# 厂商手册与规格书 PDF（合计 ~25 MB，可从厂商资料站重新下载，不入库）
# 用「目录/* + !.gitkeep」写法保留目录结构；写成「目录/」会让例外规则失效
docs/vendor/purplepi-oh2/*
docs/vendor/som7609/*
!docs/vendor/purplepi-oh2/.gitkeep
!docs/vendor/som7609/.gitkeep

# 定时截屏产物与本地测试样张 (capture_screen.sh / samples/)
captures/
samples/

# 日志
logs/
*.log

# 操作系统
.DS_Store
Thumbs.db

# 测试
.pytest_cache/
.coverage
htmlcov/

# 导出目录
output/
exports/

# 缓存
.cache/
*.cache
torch_save_tb/
runs/
# ---- build 产物（不入库） ----
build/models/
build/dist/
build/calib/*.jpg
